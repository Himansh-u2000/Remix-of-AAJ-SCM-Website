{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/services/omnichannel-fulfillment",
      "destination": "/services/same-day-delivery",
      "permanent": true
    },
    {
      "source": "/services/same-day-next-day-delivery",
      "destination": "/services/same-day-delivery",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/services/warehousing",
      "destination": "/services/warehousing/index.html"
    },
